# Copie para .env e ajuste. No Railway o DATABASE_URL e injetado automaticamente
# ao adicionar o servico Postgres ao projeto - nao precisa criar nada la.

DATABASE_URL=postgres://usuario:senha@localhost:5432/bienal
PORT=3000

# Opcional: forca SSL ligado/desligado. Por padrao a app liga SSL para hosts
# externos e desliga para localhost e *.railway.internal.
# DATABASE_SSL=true

# Opcional, mas recomendado em producao: protege as rotas de gestao usadas
# pelo painel /admin - listagem da Estante de Talentos (dados pessoais),
# criacao/edicao/exclusao de historias e escrita de configuracoes. Com a chave
# definida, essas rotas exigem "Authorization: Bearer <chave>" e o painel pede
# a chave uma vez.
# CHAVE_ADMIN=troque-por-uma-chave-secreta
